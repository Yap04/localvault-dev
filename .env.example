# Firebase Web App Configuration
# Get these credentials from: Firebase Console -> Project Settings -> General -> Your Web Apps
VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google AI Studio Gemini API Key (Tier 2 fallback gateway)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Firebase App Check Local Debug Token
# In local development, you can register a debug token in Firebase Console -> App Check -> Apps -> Manage debug tokens
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true
